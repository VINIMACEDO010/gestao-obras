{
  "name": "@gestao-obras/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx --env-file-if-exists=.env src/migrate.ts",
    "seed:dev": "tsx --env-file-if-exists=.env src/seed-dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/rds-signer": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^10.1.11",
    "aws-jwt-verify": "^5.0.0",
    "fastify": "^5.2.0",
    "pg": "^8.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
