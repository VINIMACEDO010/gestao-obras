# Copie para api/.env (não vai para o Git)
NODE_ENV=development
AUTH_MODE=dev
LOG_LEVEL=info
DB_HOST=localhost
DB_NAME=obras
DB_USER=app_user
DB_PASSWORD=app_local_pw

# Usados por migrate e seed (usuário dono do banco local)
MIGRATE_DB_USER=postgres
MIGRATE_DB_PASSWORD=postgres
APP_DB_PASSWORD=app_local_pw

# LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_FORCE_PATH_STYLE=true
DOCS_BUCKET=gestao-obras-docs-local
JOBS_QUEUE_URL=http://localhost:4566/000000000000/gestao-obras-jobs
